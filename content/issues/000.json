    "lorentz_vcm": {
      "tag": "ELECTROMECHANICAL // ACTUATORS",
      "title": "Linear Voice Coil Motor (VCM) Kinematics",
      "body": "<p>A voice coil motor generates direct linear force via the Lorentz force ($F = B \\cdot I \\cdot L$). Unlike lead screws, VCMs operate with zero backlash, absolute acoustic silence, and sub-micron positioning accuracy.</p><div class=\"modal-equation-box\"><div class=\"math-label\">Lorentz Actuation Force:</div>$$F = B \\cdot I \\cdot L$$<div class=\"math-meta\">$B = 0.8\\text{ T}$, stroke settling time $< 120\\text{ ms}$, zero detent cogging</div></div>"
    },
    "pancake_optics": {
      "tag": "OPTICS // CATADIOPTRIC DESIGN",
      "title": "Folded Catadioptric Pancake Optical Architecture",
      "body": "<p>Pancake optics polarize, reflect, and transmit light multiple times between spherical glass surfaces to fold a long focal path into a 25 mm stack. However, pupil misalignment beyond 1.5 mm collapses modulation transfer function (MTF) by over 45%.</p>"
    },
