# ==========================================
# Engineering Deep Dive - Environment Config
# ==========================================

# 1. Gemini AI API Key (required for generation & vision audits)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Custom Search (PRIMARY Image Engine - 100 free queries/day)
# How to get:
#   A. Generate an API Key at: https://console.cloud.google.com/apis/credentials
#      (Enable "Custom Search API" in your Google Cloud Console)
#   B. Create a Programmable Search Engine at: https://programmablesearchengine.google.com/
#      - Under "What to search": Select "Search the entire web"
#      - Under "Image search": Toggle to ON
#   C. Copy your Search Engine ID (CX) and paste below:
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_CX=your_search_engine_cx_id_here

# 3. DuckDuckGo Image Search (BACKUP Image Engine)
# No API keys or account required. Automatically runs as a backup whenever:
#   - Google Search credentials are not set
#   - Google daily 100-query quota is reached
#   - Google returns 0 image results for a query
